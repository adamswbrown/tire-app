# Database Configuration
# Neon PostgreSQL connection string (include sslmode=require)
DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"

# Auth.js Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-minimum-32-characters"

# Microsoft Entra ID (Azure AD) OAuth
# Get these from Azure Portal → App Registrations
AUTH_MICROSOFT_ENTRA_ID_ID="your-application-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-client-secret"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="your-directory-tenant-id"

# Application URL
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional: Database connection pool size (default: 10)
# DB_POOL_SIZE="10"

# Optional: Node Environment
# Automatically set by Vercel, but can override for testing
# NODE_ENV="development"
